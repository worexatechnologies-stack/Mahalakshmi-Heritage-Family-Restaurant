# Mahalakshmi Spice Heritage - Environment Configuration

# Destination Email for all bookings & inquiries (Default: mshfamilyrestaurant@gmail.com)
RECIPIENT_EMAIL=mshfamilyrestaurant@gmail.com
RECIPIENT_NAME="Mahalakshmi Spice Heritage Reservations"

# Sender settings
SENDER_EMAIL=mshfamilyrestaurant@gmail.com
SENDER_NAME="Mahalakshmi Spice Heritage"

# Gmail SMTP Configuration
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=mshfamilyrestaurant@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
