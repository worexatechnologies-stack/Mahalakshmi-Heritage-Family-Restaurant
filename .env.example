# ==============================================================
# Mahalakshmi Spice Heritage Family Restaurant - Environment Configuration Template
# Copy this file to .env or .env.local and fill in your credentials
# ==============================================================

# Gmail SMTP Configuration for Table / Seat Reservations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mshfamilyrestaurant@gmail.com
SMTP_PASS=your_16_digit_app_password
RECIPIENT_EMAIL=mshfamilyrestaurant@gmail.com

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RESERVATION_AMOUNT_INR=100

# Restaurant Public Information
NEXT_PUBLIC_RESTAURANT_NAME="Mahalakshmi Spice Heritage"
NEXT_PUBLIC_RESTAURANT_FULL_NAME="Mahalakshmi Spice Heritage Family Restaurant"
NEXT_PUBLIC_RESTAURANT_PHONE="+91 91482 78837"
NEXT_PUBLIC_RESTAURANT_EMAIL="mshfamilyrestaurant@gmail.com"

# Meta Pixel (Facebook Pixel) Tracking ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
